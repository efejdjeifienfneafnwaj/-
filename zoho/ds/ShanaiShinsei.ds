/*
 * Purpose : 社内申請・承認ワークフロー（閲覧証跡つき）用データ保存アプリ
 *           ・すべての項目を text / textarea / number で持ち、意味づけは
 *             ウィジェット側が担当する（ルックアップや選択肢に依存しない）
 *           ・Wf_Access_Form が「誰が何を見たか」の証跡。追記専用。
 *             取り込み後、この1フォームだけは全ロールで編集・削除を無効にすること。
 */
application "社内申請システム"
{
	date format = "yyyy-MM-dd"
	time zone = "Asia/Tokyo"
	time format = "24-hr"

	forms
	{
		form Wf_Dept_Form
		{
			displayname = "【システム用】部署マスタ"
			success message = "保存しました。"
			Section
			(
				type = section
				row = 1
				column = 0
				width = medium
			)
			dept_id
			(
				type = text
				displayname = "部署ID"
				row = 1
				column = 1
				width = medium
			)
			dept_code
			(
				type = text
				displayname = "部署コード"
				row = 1
				column = 1
				width = medium
			)
			dept_name
			(
				type = text
				displayname = "部署名"
				row = 1
				column = 1
				width = medium
			)
			parent_id
			(
				type = text
				displayname = "上位部署ID"
				row = 1
				column = 1
				width = medium
			)
			head_id
			(
				type = text
				displayname = "部門長ID"
				row = 1
				column = 1
				width = medium
			)
			sort_order
			(
				type = number
				displayname = "表示順"
				row = 1
				column = 1
				width = medium
			)
			updated_at
			(
				type = text
				displayname = "更新日時"
				row = 1
				column = 1
				width = medium
			)
			actions
			{
				on add
				{
					submit
					(
						type = submit
						displayname = "送信"
					)
					reset
					(
						type = reset
						displayname = "リセット"
					)
				}
				on edit
				{
					update
					(
						type = submit
						displayname = "更新"
					)
					cancel
					(
						type = cancel
						displayname = "キャンセル"
					)
				}
			}
		}

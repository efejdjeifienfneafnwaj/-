/* =============================================================================
 * 社内申請システム  アプリケーション定義スクリプト (.ds)
 * Zoho Creator  Application Script 形式
 *
 * 【重要】
 *  Creator の .ds インポートは版によって受理される構文が異なります。
 *  インポートでエラーが出た場合は、同梱の forms_fields.csv を見ながら
 *  フォームを手動作成してください（所要 30〜40分）。項目名は widget 側の
 *  CFG.FORMS / CFG.REPORTS と一致させる必要があります。
 *
 * 【設計の要】
 *  Access_Logs = 「誰が何を見たか」の証跡。追記専用。
 *  Creator 側で必ず次の権限を設定すること：
 *    ・全ロールに Access_Logs の「追加」のみ許可、「編集」「削除」は禁止
 *    ・閲覧は管理者ロールのみ（本人分は widget 側でフィルタ）
 *  これにより、閲覧した本人が自分の足跡を消せなくなります。
 * ========================================================================== */

application Shanai_Shinsei
{
	/* application の直後はリンク名（URLに使われる識別子）です。
	 * ここは半角英数字とアンダースコアのみ。日本語を書くと Creator が
	 * 宣言を解釈できず、アプリ名が既定値（研修環境の初期アプリ名など）に
	 * なってしまうことがあります。
	 * 画面に出る日本語名は displayname 側で指定します。 */
	displayname = "社内申請システム"
	description = "社内申請・承認ワークフロー（閲覧証跡つき）"

	/* ----------------------------------------------------------------------
	 * 1. 部署マスタ
	 * -------------------------------------------------------------------- */
	form Departments
	{
		displayname = "部署マスタ"
		Department_Code = textfield
		Department_Name = textfield
		Parent_Department = lookup(Departments)
		Dept_Head = lookup(Employees)
		Sort_Order = number
		successmessage = "部署を登録しました"
	}

	/* ----------------------------------------------------------------------
	 * 2. 社員マスタ
	 *    Roles は複数選択。widget 側でカンマ区切り文字列を配列に変換します。
	 *    Deputy / Deputy_From / Deputy_To が代理承認（職務代行）の設定です。
	 * -------------------------------------------------------------------- */
	form Employees
	{
		displayname = "社員マスタ"
		Employee_ID = textfield
		Employee_Name = textfield
		Employee_Kana = textfield
		Email = emailfield
		Department = lookup(Departments)
		Title = picklist("社長","本部長","部長","課長","主任","一般")
		Manager = lookup(Employees)
		Roles = multiselect("申請者","承認者","管理者","経理","人事")
		Join_Date = date
		Paid_Leave_Balance = decimal
		Deputy = lookup(Employees)
		Deputy_From = date
		Deputy_To = date
		Is_Active = checkbox
		successmessage = "社員情報を登録しました"
	}

	/* ----------------------------------------------------------------------
	 * 3. 取引先マスタ（インボイス制度対応）
	 * -------------------------------------------------------------------- */
	form Vendors
	{
		displayname = "取引先マスタ"
		Vendor_Code = textfield
		Vendor_Name = textfield
		Invoice_Reg_No = textfield
		Is_Qualified = checkbox
		Payment_Terms = textfield
		Note = textarea

		on validate
		{
			/* 適格請求書発行事業者登録番号は T + 13桁 */
			if(input.Invoice_Reg_No != null && input.Invoice_Reg_No != "")
			{
				if(!input.Invoice_Reg_No.matches("T[0-9]{13}"))
				{
					alert "登録番号は T に続く13桁の数字で入力してください（例：T1234567890123）";
					cancel submit;
				}
				input.Is_Qualified = true;
			}
		}
	}

	/* ----------------------------------------------------------------------
	 * 4. 勘定科目マスタ
	 * -------------------------------------------------------------------- */
	form Accounts
	{
		displayname = "勘定科目マスタ"
		Account_Code = textfield
		Account_Name = textfield
		Tax_Category = picklist("課税10%","軽減8%","非課税","不課税")
		Is_Active = checkbox
	}

	/* ----------------------------------------------------------------------
	 * 5. 申請テンプレート
	 *    Field_Schema / Route_Rule に JSON を保持し、widget がそれを解釈して
	 *    フォームと承認経路を動的に生成します（ノーコードで様式追加が可能）。
	 * -------------------------------------------------------------------- */
	form Request_Types
	{
		displayname = "申請テンプレート"
		Type_Code = textfield
		Type_Name = textfield
		Category = picklist("稟議・購買","経費","人事・労務","その他")
		Icon = textfield
		Description = textfield
		Field_Schema = textarea
		Route_Rule = textarea
		Sensitivity = picklist("S","A","B","C")
		Sort_Order = number
		Is_Active = checkbox
	}

	/* ----------------------------------------------------------------------
	 * 6. 承認ルート設定（金額しきい値などの職務権限規程）
	 * -------------------------------------------------------------------- */
	form Route_Rules
	{
		displayname = "承認ルート設定"
		Rule_Name = textfield
		Request_Type = lookup(Request_Types)
		Min_Amount = currency
		Max_Amount = currency
		Condition_JSON = textarea
		Steps_JSON = textarea
		Priority = number
		Is_Active = checkbox
	}

	/* ----------------------------------------------------------------------
	 * 7. 申請（本体）
	 * -------------------------------------------------------------------- */
	form Requests
	{
		displayname = "申請"
		Request_No = textfield
		Request_Type = lookup(Request_Types)
		Type_Code = textfield
		Subject = textfield
		Applicant = lookup(Employees)
		Applicant_Dept = textfield
		Amount = currency
		Status = picklist("下書き","申請中","承認済","却下","差戻し","取下げ")
		Applied_On = datetime
		Completed_On = datetime
		Current_Step = number
		Route_JSON = textarea
		Form_Data_JSON = textarea
		Payment_Due_Date = date
		Paid = checkbox
		Journal_Exported = checkbox

		on add
		{
			/* 申請番号の自動採番 */
			if(input.Request_No == null || input.Request_No == "")
			{
				seq = Requests[ID != 0].count() + 1001;
				input.Request_No = "REQ-" + zoho.currentdate.getYear() + "-" + seq;
			}
			if(input.Status == null)
			{
				input.Status = "下書き";
			}
		}

		on success
		{
			/* 申請と同時に、作成そのものを証跡へ記録する */
			log = Access_Logs[ID == 0];
			log.Log_Time = zoho.currenttime;
			log.Actor = input.Applicant;
			log.Actor_Name = input.Applicant.Employee_Name;
			log.Actor_Dept = input.Applicant_Dept;
			log.Login_User = zoho.loginuser;
			log.Action = "作成";
			log.Target_Type = "申請";
			log.Target_ID = input.ID;
			log.Target_No = input.Request_No;
			log.Target_Subject = input.Subject;
			log.Request_Type_Code = input.Type_Code;
			log.Owner_Dept = input.Applicant_Dept;
			insert into Access_Logs(log);
		}
	}

	/* ----------------------------------------------------------------------
	 * 8. 申請明細（経費・交通費・購買の行データ）
	 * -------------------------------------------------------------------- */
	form Request_Lines
	{
		displayname = "申請明細"
		Request = lookup(Requests)
		Line_No = number
		Line_Date = date
		Account = lookup(Accounts)
		Vendor = lookup(Vendors)
		Description = textfield
		Qty = decimal
		Unit_Price = currency
		Amount = currency
		Tax_Rate = picklist("課税10%","軽減8%","非課税","不課税")
		Tax_Amount = currency
		Invoice_No = textfield
		Note = textfield

		on validate
		{
			if(input.Amount == null && input.Qty != null && input.Unit_Price != null)
			{
				input.Amount = input.Qty * input.Unit_Price;
			}
			if(input.Tax_Rate == "課税10%")
			{
				input.Tax_Amount = input.Amount - (input.Amount / 1.1).round(0);
			}
			else if(input.Tax_Rate == "軽減8%")
			{
				input.Tax_Amount = input.Amount - (input.Amount / 1.08).round(0);
			}
			else
			{
				input.Tax_Amount = 0;
			}
		}
	}

	/* ----------------------------------------------------------------------
	 * 9. 承認履歴
	 * -------------------------------------------------------------------- */
	form Approvals
	{
		displayname = "承認履歴"
		Request = lookup(Requests)
		Step_No = number
		Step_Name = textfield
		Step_Type = picklist("承認","合議","或議","回覧")
		Approver = lookup(Employees)
		Acted_By = lookup(Employees)
		Action = picklist("未処理","承認","却下","差戻し","条件付承認","既読","スキップ")
		Comment = textarea
		Due_Date = date
		Acted_On = datetime
		Is_Delegate = checkbox
	}

	/* ----------------------------------------------------------------------
	 * 10. 閲覧証跡 ★本システムの中核
	 *     追記専用。Creator 側の権限設定で「編集」「削除」を全ロールに与えない。
	 * -------------------------------------------------------------------- */
	form Access_Logs
	{
		displayname = "閲覧証跡"
		Log_Time = datetime
		Session_ID = textfield
		Actor = lookup(Employees)
		Actor_Name = textfield
		Actor_Dept = textfield
		Actor_Role = textfield
		Login_User = textfield
		Action = picklist("詳細閲覧","一覧閲覧","検索","CSV出力","印刷","添付DL","閲覧証跡の閲覧","アクセス拒否","利用開始","ユーザー切替","作成")
		Target_Type = textfield
		Target_ID = textfield
		Target_No = textfield
		Target_Subject = textfield
		Request_Type_Code = textfield
		Sensitivity = picklist("S","A","B","C")
		Owner_Dept = textfield
		Cross_Dept = checkbox
		Result_Count = number
		Duration_Sec = number
		Detail = textarea
		User_Agent = textfield
	}

	/* ----------------------------------------------------------------------
	 * 11. 操作証跡（データ変更の記録。閲覧証跡とは別に持つ）
	 * -------------------------------------------------------------------- */
	form Audit_Logs
	{
		displayname = "操作証跡"
		Log_Time = datetime
		User = lookup(Employees)
		User_Name = textfield
		Action_Type = textfield
		Target_Type = textfield
		Target_ID = textfield
		Detail = textarea
		Session_ID = textfield
	}

	/* ----------------------------------------------------------------------
	 * 12. 通知
	 * -------------------------------------------------------------------- */
	form Notifications
	{
		displayname = "通知"
		To_User = lookup(Employees)
		Request = lookup(Requests)
		Kind = textfield
		Message = textfield
		Is_Read = checkbox
		Created_Time = datetime
	}

	/* ======================================================================
	 * レポート定義
	 *  widget からは CFG.REPORTS のリンク名で参照します。
	 * ==================================================================== */
	view Requests_Report
	{
		displayname = "申請一覧"
		type = report
		formname = Requests
		columns = Request_No, Type_Code, Subject, Applicant, Applicant_Dept, Amount, Status, Applied_On, Completed_On, Current_Step, Route_JSON, Form_Data_JSON, Payment_Due_Date, Paid
	}
	view Employees_Report      { type = report  formname = Employees }
	view Departments_Report    { type = report  formname = Departments }
	view Vendors_Report        { type = report  formname = Vendors }
	view Accounts_Report       { type = report  formname = Accounts }
	view Request_Types_Report  { type = report  formname = Request_Types }
	view Request_Lines_Report  { type = report  formname = Request_Lines }
	view Approvals_Report      { type = report  formname = Approvals }
	view Route_Rules_Report    { type = report  formname = Route_Rules }
	view Audit_Logs_Report     { type = report  formname = Audit_Logs }
	view Notifications_Report  { type = report  formname = Notifications }

	view Access_Logs_Report
	{
		displayname = "閲覧証跡"
		type = report
		formname = Access_Logs
		columns = Log_Time, Actor_Name, Actor_Dept, Actor_Role, Action, Target_No, Target_Subject, Sensitivity, Owner_Dept, Cross_Dept, Duration_Sec, Detail
		sortby = Log_Time
		sortorder = descending
		/* ★権限：全ロールで「編集」「削除」を無効にすること（Creator の権限画面で設定） */
	}

	/* 「私の申請を誰が見たか」を本人が確認するためのレポート */
	view My_Record_Viewers
	{
		displayname = "自分の申請の閲覧者"
		type = report
		formname = Access_Logs
		criteria = (Action == "詳細閲覧")
		columns = Log_Time, Actor_Name, Actor_Dept, Target_No, Target_Subject, Duration_Sec
		sortby = Log_Time
		sortorder = descending
	}

	/* 承認トレイ（未処理のみ） */
	view Approval_Inbox
	{
		displayname = "承認トレイ"
		type = report
		formname = Approvals
		criteria = (Action == "未処理")
		columns = Request, Step_No, Step_Name, Step_Type, Approver, Due_Date
	}

	/* ダッシュボード（widget を埋め込むページ） */
	page Workflow_Console
	{
		displayname = "社内申請コンソール"
		/* Creator のページ編集画面で widget「shanai_shinsei」をこのページに配置します */
	}
}

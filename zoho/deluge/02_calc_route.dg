/* =============================================================================
 * カスタム関数：calc_route
 *  用途：申請レコードから承認経路を生成し、Approvals を作成する
 *  呼び出し：Requests フォームの on success、または widget から REST 経由
 *  ※ widget 側 workflow.js と同じロジックです。サーバー側でも計算することで
 *    「画面を改造して経路を飛ばす」ことができなくなります。
 * ========================================================================== */
void calc_route(int requestId)
{
	req = Requests[ID == requestId];
	tpl = Request_Types[Type_Code == req.Type_Code];
	applicant = req.Applicant;
	formData = req.Form_Data_JSON.toMap();
	routeRule = tpl.Route_Rule.toMap();
	steps = routeRule.get("steps").toJSONList();

	stepNo = 0;
	seen = List();
	routeOut = List();

	for each st in steps
	{
		stMap = st.toMap();
		/* --- 条件判定（when） --- */
		include = true;
		if(stMap.get("when") != null)
		{
			w = stMap.get("when").toMap();
			fieldVal = formData.get(w.get("field"));
			if(w.get("eq") != null)
			{
				include = (fieldVal.toString() == w.get("eq").toString());
			}
			else
			{
				n = ifnull(fieldVal, 0).toDecimal();
				if(w.get("gte") != null && n < w.get("gte").toDecimal())
				{
					include = false;
				}
				if(w.get("lt") != null && n >= w.get("lt").toDecimal())
				{
					include = false;
				}
			}
		}
		if(include)
		{
			/* --- 承認者の解決 --- */
			asg = stMap.get("assignee").toMap();
			mode = asg.get("mode");
			approver = null;
			if(mode == "manager")
			{
				lv = ifnull(asg.get("level"), 1).toLong();
				cur = applicant;
				idx = 0;
				while(idx < lv)
				{
					if(cur != null)
					{
						cur = cur.Manager;
					}
					idx = idx + 1;
				}
				approver = cur;
			}
			else if(mode == "title")
			{
				cand = Employees[Title == asg.get("title") && Department.Department_Name == applicant.Department.Department_Name && Is_Active == true];
				if(cand.count() == 0)
				{
					cand = Employees[Title == asg.get("title") && Is_Active == true];
				}
				if(cand.count() > 0)
				{
					approver = cand.ID;
				}
			}
			else if(mode == "department")
			{
				cand = Employees[Department.Department_Name == asg.get("department") && Is_Active == true] sort by Title;
				if(cand.count() > 0)
				{
					approver = cand.ID;
				}
			}

			stepNo = stepNo + 1;
			skipped = false;
			skipReason = "";
			if(approver == null)
			{
				skipped = true;
				skipReason = "該当する承認者が存在しないため自動スキップ";
			}
			else if(approver.ID == applicant.ID)
			{
				skipped = true;
				skipReason = "申請者本人のため自動スキップ";
			}
			else if(seen.contains(approver.ID.toString()))
			{
				skipped = true;
				skipReason = "同一承認者の重複のため自動スキップ";
			}
			if(!skipped)
			{
				seen.add(approver.ID.toString());
			}

			/* --- 代理承認（職務代行）の判定 --- */
			isDelegate = false;
			actualApprover = approver;
			if(!skipped && approver.Deputy != null)
			{
				today = zoho.currentdate;
				okFrom = (approver.Deputy_From == null || today >= approver.Deputy_From);
				okTo = (approver.Deputy_To == null || today <= approver.Deputy_To);
				if(okFrom && okTo)
				{
					isDelegate = true;
				}
			}

			/* --- Approvals レコードの作成 --- */
			ap = Approvals[ID == 0];
			ap.Request = requestId;
			ap.Step_No = stepNo;
			ap.Step_Name = stMap.get("name");
			ap.Step_Type = ifnull(stMap.get("type"), "承認");
			if(approver != null)
			{
				ap.Approver = approver.ID;
			}
			if(skipped)
			{
				ap.Action = "スキップ";
				ap.Comment = skipReason;
			}
			else
			{
				ap.Action = "未処理";
				ap.Due_Date = zoho.currentdate.addDay(ifnull(stMap.get("days"), 3).toLong());
			}
			ap.Is_Delegate = isDelegate;
			insert into Approvals(ap);
		}
	}

	/* --- 申請側の現在ステップを更新 --- */
	firstPending = Approvals[Request == requestId && Action == "未処理"] sort by Step_No;
	req.Current_Step = if(firstPending.count() > 0, firstPending.Step_No, 0);
	req.Status = if(firstPending.count() > 0, "申請中", "承認済");
}

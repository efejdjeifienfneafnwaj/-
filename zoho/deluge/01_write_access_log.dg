/* =============================================================================
 * カスタム関数：write_access_log
 *  用途：widget からの閲覧証跡の書き込み口（REST API として公開）
 *  公開手順：設定 → API → カスタム関数を REST API として公開
 *  ポイント：この関数だけが Access_Logs への書き込み経路になるため、
 *            ユーザーに Access_Logs フォームの直接権限を与える必要がありません。
 *            ＝ 閲覧した本人が自分の足跡を消せない構造になります。
 * ========================================================================== */
string write_access_log(string payload)
{
	rec = payload.toMap();
	log = Access_Logs[ID == 0];
	log.Log_Time = zoho.currenttime;
	log.Session_ID = rec.get("Session_ID");
	log.Actor_Name = rec.get("Actor_Name");
	log.Actor_Dept = rec.get("Actor_Dept");
	log.Actor_Role = rec.get("Actor_Role");
	/* ★ Login_User はクライアントの申告値ではなく、必ずサーバー側の値を使う */
	log.Login_User = zoho.loginuser;
	log.Action = rec.get("Action");
	log.Target_Type = rec.get("Target_Type");
	log.Target_ID = rec.get("Target_ID");
	log.Target_No = rec.get("Target_No");
	log.Target_Subject = rec.get("Target_Subject");
	log.Request_Type_Code = rec.get("Request_Type_Code");
	log.Sensitivity = rec.get("Sensitivity");
	log.Owner_Dept = rec.get("Owner_Dept");
	log.Cross_Dept = if(rec.get("Cross_Dept") == true, true, false);
	log.Result_Count = rec.get("Result_Count");
	log.Duration_Sec = rec.get("Duration_Sec");
	log.Detail = rec.get("Detail");
	log.User_Agent = rec.get("User_Agent");

	/* 操作者はログインユーザーから逆引きする（なりすまし防止） */
	actor = Employees[Email == zoho.loginuser];
	if(actor.count() > 0)
	{
		log.Actor = actor.ID;
		log.Actor_Name = actor.Employee_Name;
		log.Actor_Dept = actor.Department.Department_Name;
	}
	insert into Access_Logs(log);
	return "ok";
}

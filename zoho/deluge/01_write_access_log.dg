/* =============================================================================
 * カスタム関数：write_access_log
 *
 * 目的：閲覧証跡の書き込み口をこの関数1本に絞る。
 *   ウィジェットに Wf_Access_Form への直接の追加権限を与えず、この関数だけを
 *   REST API として公開すると、Login_User をサーバー側の値で上書きできるため、
 *   他人になりすました証跡を作れなくなります。
 *
 * 公開手順：設定 → API → カスタム関数を REST API として公開
 * 適用後は widget の CFG.CUSTOM_API.writeAccessLog を有効にしてください。
 * ※ 本番の Creator では未検証です。取り込み後に1件テスト実行してください。
 * ========================================================================== */
string write_access_log(string payload)
{
	rec = payload.toMap();

	log = Wf_Access_Form[ID == 0];
	log.log_time = zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ss");
	log.session_id = rec.get("session_id");
	log.action = rec.get("action");
	log.target_type = rec.get("target_type");
	log.target_id = rec.get("target_id");
	log.target_no = rec.get("target_no");
	log.target_subject = rec.get("target_subject");
	log.type_code = rec.get("type_code");
	log.sensitivity = rec.get("sensitivity");
	log.owner_dept = rec.get("owner_dept");
	log.cross_dept = rec.get("cross_dept");
	log.result_count = rec.get("result_count");
	log.duration_sec = rec.get("duration_sec");
	log.detail = rec.get("detail");
	log.user_agent = rec.get("user_agent");

	/* ★ 操作者はクライアントの申告ではなく、ログインユーザーから逆引きする */
	log.login_user = zoho.loginuser;
	actor = Wf_Employee_Form[email == zoho.loginuser];
	if(actor.count() > 0)
	{
		log.actor_id = actor.ID.toString();
		log.actor_name = actor.emp_name;
		log.actor_dept = actor.dept_name;
		log.actor_role = actor.roles;
	}
	else
	{
		log.actor_name = zoho.loginuser;
	}
	insert into Wf_Access_Form(log);
	return "ok";
}

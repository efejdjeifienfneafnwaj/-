/* =============================================================================
 * スケジュール関数：weekly_access_audit（毎週月曜 8:00 実行を推奨）
 *
 * 目的：先週1週間の閲覧証跡を集計し、管理者へ要約を通知する。
 *   ・深夜（22時〜翌5時）のアクセス件数
 *   ・他部署からの機微度 S / A 申請の閲覧件数
 *   ・CSV出力の件数（持ち出しの目安）
 * ※ 本番の Creator では未検証です。まず手動実行で動作を確認してください。
 * ========================================================================== */
void weekly_access_audit()
{
	since = zoho.currentdate.subDay(7).toString("yyyy-MM-dd");
	logs = Wf_Access_Form[log_time >= since];

	total = 0;
	night = 0;
	cross = 0;
	exported = 0;
	denied = 0;

	for each l in logs
	{
		total = total + 1;
		hourText = l.log_time.substring(11, 13);
		h = ifnull(hourText, "12").toLong();
		if(h >= 22 || h < 5)
		{
			night = night + 1;
		}
		if(l.cross_dept == "true" && (l.sensitivity == "S" || l.sensitivity == "A"))
		{
			cross = cross + 1;
		}
		if(l.action == "CSV出力")
		{
			exported = exported + 1;
		}
		if(l.action == "アクセス拒否")
		{
			denied = denied + 1;
		}
	}

	summary = "先週の閲覧証跡：総" + total + "件／深夜" + night + "件／他部署の機微閲覧" + cross + "件／CSV出力" + exported + "件／アクセス拒否" + denied + "件";
	admins = Wf_Employee_Form[roles.contains("管理者") && is_active == "true"];
	for each ad in admins
	{
		n = Wf_Notify_Form[ID == 0];
		n.to_user_id = ad.ID.toString();
		n.kind = "週次監査";
		n.message = summary;
		n.is_read = "false";
		n.created_time = zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ss");
		insert into Wf_Notify_Form(n);
	}
}
